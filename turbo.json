{
  "tasks": {
    "bundle": {
      "outputs": [".remotion/**"]
    },
    "build": {
      "dependsOn": ["bundle"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["BLOB_STORE_ID", "BLOB_READ_WRITE_TOKEN"],
      "passThroughEnv": ["VERCEL_OIDC_TOKEN"]
    },
    "create-snapshot": {
      "dependsOn": ["bundle"],
      "env": ["BLOB_STORE_ID", "BLOB_READ_WRITE_TOKEN"],
      "passThroughEnv": ["VERCEL_OIDC_TOKEN", "VERCEL_DEPLOYMENT_ID"]
    }
  },
  "dangerouslyDisablePackageManagerCheck": true
}
